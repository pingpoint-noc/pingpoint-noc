[Unit]
Description=Mini-NOC SNMP poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@RUN_USER@
WorkingDirectory=@INSTALL_DIR@
Environment="MININOC_DB_PATH=@INSTALL_DIR@/data/mini_noc.db"
Environment="MININOC_SNMP_COMMUNITY=public"
Environment="MININOC_SNMP_INTERVAL=15"
EnvironmentFile=-@INSTALL_DIR@/mini-noc.env
ExecStart=@INSTALL_DIR@/.venv/bin/python -m collectors.snmp.poller
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=@INSTALL_DIR@/data
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
