[Unit]
Description=Mini-NOC syslog ingestor
After=network-online.target rsyslog.service
Wants=network-online.target

[Service]
Type=simple
User=@RUN_USER@
SupplementaryGroups=adm
WorkingDirectory=@INSTALL_DIR@
Environment="MININOC_DB_PATH=@INSTALL_DIR@/data/mini_noc.db"
EnvironmentFile=-@INSTALL_DIR@/mini-noc.env
ExecStart=@INSTALL_DIR@/.venv/bin/python -m collectors.syslog.ingestor
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=@INSTALL_DIR@/data
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
