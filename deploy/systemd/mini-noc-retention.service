[Unit]
Description=Mini-NOC retention (delete old data, free disk space)

[Service]
Type=oneshot
User=@RUN_USER@
WorkingDirectory=@INSTALL_DIR@
Environment="MININOC_DB_PATH=@INSTALL_DIR@/data/mini_noc.db"
Environment="MININOC_RETENTION_DAYS=15"
EnvironmentFile=-@INSTALL_DIR@/mini-noc.env
ExecStart=@INSTALL_DIR@/.venv/bin/python -m maintenance.retention
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=@INSTALL_DIR@/data
ProtectKernelTunables=yes
ProtectControlGroups=yes
