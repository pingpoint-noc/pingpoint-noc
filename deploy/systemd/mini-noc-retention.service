[Unit]
Description=Mini-NOC retention (delete old data, free disk space)

[Service]
Type=oneshot
User=@RUN_USER@
WorkingDirectory=@INSTALL_DIR@
Environment="MININOC_DB_PATH=@INSTALL_DIR@/data/mini_noc.db"
Environment="MININOC_RETENTION_DAYS=15"
EnvironmentFile=-@INSTALL_DIR@/mini-noc.env
ExecStart=@INSTALL_DIR@/.venv/bin/python -m maintenance.retention
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=@INSTALL_DIR@/data
ProtectKernelTunables=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
ProtectHome=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0077
