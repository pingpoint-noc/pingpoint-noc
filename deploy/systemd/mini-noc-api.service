[Unit]
Description=Mini-NOC HTTP API service
After=network-online.target mini-noc-snmp.service
Wants=network-online.target

[Service]
Type=simple
User=@RUN_USER@
WorkingDirectory=@INSTALL_DIR@
Environment="MININOC_DB_PATH=@INSTALL_DIR@/data/mini_noc.db"
Environment="MININOC_API_HOST=0.0.0.0"
Environment="MININOC_API_PORT=8080"
EnvironmentFile=-@INSTALL_DIR@/mini-noc.env
ExecStart=@INSTALL_DIR@/.venv/bin/python -m api
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# SQLite opens the database with ?mode=ro (no SQL writes allowed), but WAL mode
# still maps/creates the mini_noc.db-shm wal-index file in data/.
ReadWritePaths=@INSTALL_DIR@/data
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target

