# OPCIONAL. Aqui se describe el ESCENARIO (router, redes, IPs propias, colector) y se ajusta el servicio.
# Sin este fichero, el NOC usa los valores del lab (scenario.py), que son los que aparecen aqui:
# no hace falta tocar nada si tu lab es el mismo; lo tipico que cambia es la IP WAN del router.
# Copialo a <repo>/mini-noc.env (esta ignorado por git; install.sh no lo crea ni lo sobrescribe),
# deja solo lo que cambie y reinicia:
#   sudo systemctl restart mini-noc-snmp mini-noc-syslog mini-noc-ipfix mini-noc-api
# Guia: docs/adaptar-a-otro-escenario.md. `python -m tools.preflight` muestra los valores efectivos.

# --- ESCENARIO (valores por defecto = lab; una variable vacia equivale a no ponerla) ---
# Router a monitorizar (SNMP, syslog, IPFIX) y como se llama en la base de datos.
MININOC_ROUTER_IP=192.168.88.1
MININOC_DEVICE_ID=edge-router-1
MININOC_DEVICE_NAME=edge-router
# IP de este colector tal como la ve el router: la ofrecen los endpoints /api/bootstrap.sh y
# /api/router-config.rsc cuando la peticion no dice otra (y es el destino por defecto de tools.generate_router_config).
MININOC_NOC_IP=192.168.88.4
# Zona horaria IANA en la que se MUESTRA todo (web, resumen diario, formulario de mantenimiento); lo guardado sigue en UTC.
# Ejemplos: America/New_York, Asia/Kolkata, UTC. Una zona invalida se registra como error y se usa Europe/Madrid
# (tools.preflight da FAIL). Necesita el paquete tzdata (requirements.txt).
MININOC_TZ=Europe/Madrid

# SNMP (solo lo usa el servicio snmp).
MININOC_SNMP_COMMUNITY=public
# SNMPv3 authPriv (opcional; ver docs/diseno-snmpv3.md). Sin USER se usa v2c con la comunidad de arriba.
# MININOC_SNMP_V3_USER=mininoc
# MININOC_SNMP_V3_AUTH_PROTOCOL=SHA
# MININOC_SNMP_V3_AUTH_KEY=
# MININOC_SNMP_V3_PRIV_PROTOCOL=AES
# MININOC_SNMP_V3_PRIV_KEY=
# Credenciales POR EQUIPO (varios routers; ver docs/adaptar-a-otro-escenario.md): perfiles con nombre. El inventario guarda
# solo el nombre (python -m tools.add_device --id router-2 --name "Router 2" --ip 192.168.89.1 --cred core-v3).
# El nombre va en MAYUSCULAS y con _ donde el inventario lleve - (core-v3 -> CORE_V3). Un perfil es v2c o v3, no los dos.
# Sin perfil, cada equipo usa su comunidad y el router principal sigue con MININOC_SNMP_V3_*. Reiniciar mini-noc-snmp al cambiarlos.
# Perfil v2c:
# MININOC_SNMP_CRED_LAB_V2_COMMUNITY=
# Perfil v3 authPriv (mismas reglas que MININOC_SNMP_V3_*; MD5/DES solo con _ALLOW_WEAK=yes):
# MININOC_SNMP_CRED_CORE_V3_USER=
# MININOC_SNMP_CRED_CORE_V3_AUTH_PROTOCOL=SHA
# MININOC_SNMP_CRED_CORE_V3_AUTH_KEY=
# MININOC_SNMP_CRED_CORE_V3_PRIV_PROTOCOL=AES
# MININOC_SNMP_CRED_CORE_V3_PRIV_KEY=

# IPFIX: redes internas tuyas y la direccion WAN del router (nunca se atribuye como host).
# Si no coinciden con tu red, los flujos saldran con internal_host vacio o mal atribuidos.
MININOC_INTERNAL_NETS=192.168.88.0/24,192.168.89.0/24
MININOC_ROUTER_OWN_IPS=192.168.100.2

# Retencion en dias (servicio de retencion).
MININOC_RETENTION_DAYS=15
# Tope de tamano de la BD en MB (0 = sin tope). Se borra lo mas antiguo primero; las ultimas 24 h nunca.
MININOC_MAX_DB_MB=1024

# API HTTP (servicio mini-noc-api).
MININOC_API_HOST=0.0.0.0
MININOC_API_PORT=8080

# Motor de alertas (servicio mini-noc-alerts).
MININOC_ALERT_INTERVAL=30
# Good cycles in a row before a firing alert resolves (1 = at once; 2 hides a problem that comes and goes)
MININOC_RESOLVE_CYCLES=2
# Unstable interface: status changes in the window that raise interface_flapping (starting values, tune with lab data)
MININOC_FLAP_CHANGES=3
MININOC_FLAP_WINDOW_SECONDS=300
# Errors and discards per interface: growth inside the window (not the accumulated counter); starting values
MININOC_ERR_WINDOW_SECONDS=300
MININOC_ERR_MIN_INCREASE=10
MININOC_ERR_MIN_INTERVALS=3
MININOC_ALERT_BW_BPS=10000000
MININOC_ALERT_BW_HOLD_SECONDS=120
MININOC_ALERT_FAILED_LOGINS=5
MININOC_ALERT_STALE_SECONDS=300
MININOC_ALERT_DNS_LATENCY_MS=500.0
MININOC_ALERT_DNS_BLOCKLIST_MIN_QUERIES=100
# Flows (starting values): port scan, rare long connection, new destination learning
MININOC_ALERT_PORT_SCAN_PORTS=15
MININOC_ALERT_PORT_SCAN_WINDOW_SECONDS=180
MININOC_ALERT_RARE_CONN_DURATION_SECONDS=120
MININOC_NEWDST_LEARNING_HOURS=24
MININOC_NEWDST_BASELINE=20
MININOC_NEWDST_BURST=10
MININOC_NEWDST_WINDOW_SECONDS=600

# Poller de DNS / Pi-hole (servicio mini-noc-dns).
MININOC_DNS_POLL_INTERVAL=30

# Recolector ICMP (servicio mini-noc-icmp): segundos entre ciclos de cinco pings a cada equipo activo.
# MININOC_ICMP_POLL_INTERVAL=60
# Pi-hole v6 protege su API con contraseña (la de la interfaz web o una "app password" de Settings > Web interface / API).
# Sin ella solo se ve la latencia del puerto 53: faltan las consultas, los bloqueos y los listados de DNS Insights, y la web lo dice.
# Se guarda solo aqui (no en la base de datos). Reinicia: sudo systemctl restart mini-noc-dns
# MININOC_PIHOLE_PASSWORD=
# AdGuard Home (dns_type "adguard" en poll_config_json; docs/dns-adaptadores.md): usuario y contraseña de su interfaz web (basic auth).
# Solo aqui. Sin ellos la API devuelve 401 y la web lo explica; la sonda UDP 53 sigue funcionando.
# MININOC_ADGUARD_USER=
# MININOC_ADGUARD_PASSWORD=

# Notificaciones push con ntfy (opcional). Vacio = desactivadas. Mejor un ntfy propio que ntfy.sh (docs/ajustes-y-notificaciones.md).
# MININOC_NTFY_URL=http://localhost:8081/mini-noc
# MININOC_NTFY_TOKEN=

# Panel de Ajustes de la web (pestana Settings). Sin esta variable el panel es de solo lectura.
# Pon un valor largo y aleatorio; quien lo tenga puede cambiar a donde van las alertas.
# MININOC_ADMIN_TOKEN=

# Syslog: the native receiver listens on UDP 514 by default (no rsyslog needed). Change the port or the address here.
#MININOC_SYSLOG_PORT=514
#MININOC_SYSLOG_BIND=0.0.0.0
